# Populate these in the deployment secret store, never in a committed .env.
GRAFANA_ADMIN_PASSWORD=replace-with-a-secret
OTEL_DEPLOYMENT_ENVIRONMENT=production
KAIROS_LOG_ROOT=/var/lib/kairos/logs
KAIROS_OTLP_TLS_CERT_FILE=/run/secrets/otel-server-cert.pem
KAIROS_OTLP_TLS_KEY_FILE=/run/secrets/otel-server-key.pem
KAIROS_OTLP_TLS_CLIENT_CA_FILE=/run/secrets/otel-client-ca.pem
KAIROS_BACKEND_TLS_CA_FILE=/run/secrets/backend-ca.pem
KAIROS_BACKEND_TLS_CERT_FILE=/run/secrets/collector-client-cert.pem
KAIROS_BACKEND_TLS_KEY_FILE=/run/secrets/collector-client-key.pem
KAIROS_TEMPO_OTLP_ENDPOINT=tempo.example.internal:4317
KAIROS_PROMETHEUS_REMOTE_WRITE_ENDPOINT=https://prometheus.example.internal/api/v1/write
KAIROS_PROMETHEUS_AUTHORIZATION=Bearer replace-with-a-secret
KAIROS_LOKI_OTLP_ENDPOINT=https://loki.example.internal/otlp
KAIROS_LOKI_AUTHORIZATION=Bearer replace-with-a-secret
