{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.local/schemas/v2/mmap-manifest.schema.json",
  "title": "Kairos v2 mmap resource manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_generation",
    "owner",
    "publisher_id",
    "publisher_resource_id",
    "scope",
    "workspace_id",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "manifest_generation": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "enum": ["market", "account", "risk", "execution", "system"]
    },
    "publisher_id": {
      "type": "string",
      "minLength": 1
    },
    "publisher_resource_id": {
      "$ref": "#/$defs/safeResourceId"
    },
    "scope": {
      "enum": ["workspace", "instance"]
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "launch_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "instance_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "instance"
          }
        }
      },
      "then": {
        "required": ["launch_id", "instance_id"],
        "properties": {
          "launch_id": {
            "type": "string",
            "minLength": 1
          },
          "instance_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "safeResourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_name",
        "resource_id",
        "resource_epoch",
        "relative_path",
        "file_identifier",
        "view_key",
        "slot_size",
        "max_payload_bytes",
        "max_rows",
        "required"
      ],
      "properties": {
        "semantic_name": {
          "enum": [
            "quote_current",
            "bar_current",
            "greeks_current",
            "account_current",
            "observed_orders_current",
            "risk_current",
            "active_intents_current",
            "active_orders_current",
            "system_health_current",
            "alerts_current"
          ]
        },
        "resource_id": {
          "$ref": "#/$defs/safeResourceId"
        },
        "resource_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "relative_path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,191}\\.mmap$"
        },
        "file_identifier": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "view_key": {
          "type": "string",
          "minLength": 1
        },
        "slot_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "shard_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "shard_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "required": {
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "shard_id": ["shard_count"],
        "shard_count": ["shard_id"]
      }
    }
  }
}
