include "../../common/metadata.fbs";
include "../types/observed_order.fbs";

namespace kairos.account.v2;

table SegmentObservedOrders {
  segment_key:string (required);
  // This vector is a current provider observation, not an order lifecycle
  // history. Terminal orders are normally absent from this view.
  orders:[ObservedOrder] (required);
}

table ObservedOrdersCurrentView {
  metadata:kairos.common.v2.ViewMetadata (required);
  account_id:string (required);
  segments:[SegmentObservedOrders] (required);
}

root_type ObservedOrdersCurrentView;
file_identifier "AOV2";
