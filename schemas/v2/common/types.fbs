namespace kairos.common.v2;

enum Side:ubyte {
  UNSPECIFIED = 0,
  BUY = 1,
  SELL = 2
}

enum DependencyOwner:ubyte {
  UNSPECIFIED = 0,
  REFERENCE = 1,
  MARKET = 2,
  ACCOUNT = 3,
  RISK = 4,
  EXECUTION = 5
}

enum EvidenceKind:ubyte {
  UNSPECIFIED = 0,
  EVENT = 1,
  CURRENT_VIEW = 2,
  REFERENCE_REVISION = 3
}

/// Audit evidence used by a decision. It is not a resumable event cursor.
table EvidenceRef {
  owner:DependencyOwner = UNSPECIFIED;
  kind:EvidenceKind = UNSPECIFIED;
  event_id:string;
  stream_id:string;
  sequence:ulong = null;
  snapshot_id:string;
  generation:ulong = null;
  reference_revision:ulong = null;
  as_of_unix_nanos:ulong = null;
}
