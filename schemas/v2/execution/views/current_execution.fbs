include "../../common/metadata.fbs";
include "../types/order.fbs";
include "../types/plan.fbs";
include "../types/fill.fbs";

namespace kairos.execution.v2;

table OrderLifecycleEventState {
  order_id:string (required);
  intent_id:string;
  plan_id:string;
  leg_id:string;
  lifecycle:OrderLifecycle = UNSPECIFIED;
  remote_order_id:string;
  occurred_at_unix_nanos:ulong;
  reason:string;
  fill_id:string;
  filled_quantity:kairos.common.v2.Decimal64;
}

table IntentLifecycleEventState {
  intent_id:string (required);
  event_sequence:ulong;
  lifecycle:IntentLifecycle = UNSPECIFIED;
  order_ids:[string] (required);
  completed_quantity:kairos.common.v2.Decimal64 (required);
  occurred_at_unix_nanos:ulong;
  reason:string;
  strategy_decision_id:string;
  previous_lifecycle:IntentLifecycle = UNSPECIFIED;
}

table UnknownRemoteOrderState {
  remote_order_id:string (required);
  symbol:string (required);
  lifecycle:OrderLifecycle = UNSPECIFIED;
  execution_id:string;
  fill_quantity:kairos.common.v2.Decimal64;
  fill_price:kairos.common.v2.Decimal64;
  fee_currency:string;
  fee_amount:kairos.common.v2.Decimal64;
  first_seen_at_unix_nanos:ulong;
  last_seen_at_unix_nanos:ulong;
  resolution:string (required);
  reason:string;
}

table CurrentExecutionView {
  metadata:kairos.common.v2.ViewMetadata (required);
  orders:[OrderState] (required);
  intents:[IntentState] (required);
  fills:[Fill] (required);
  order_events:[OrderLifecycleEventState] (required);
  intent_events:[IntentLifecycleEventState] (required);
  unknown_remote_orders:[UnknownRemoteOrderState] (required);
  commitments:[OrderCommitmentState] (required);
  risk_reservations:[RiskReservationSagaState] (required);
  exchange_event_watermark_unix_nanos:ulong;
  fill_history_truncated:bool;
  order_event_history_truncated:bool;
  intent_event_history_truncated:bool;
}

root_type CurrentExecutionView;
file_identifier "ECV2";
