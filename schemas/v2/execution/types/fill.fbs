include "../../common/decimal.fbs";
include "../../common/types.fbs";

namespace kairos.execution.v2;

table Fill {
  fill_id:string (required);
  trade_id:string;
  order_id:string (required);
  intent_id:string (required);
  plan_id:string (required);
  leg_id:string (required);
  strategy_id:string (required);
  account_id:string (required);
  segment_key:string (required);
  instrument_id:string (required);
  market_id:string (required);
  execution_route_id:string (required);
  remote_order_id:string;
  reported_broker_id:string;
  execution_channel:string;
  provider_symbol:string;
  side:kairos.common.v2.Side = UNSPECIFIED;
  quantity:kairos.common.v2.Decimal64 (required);
  price:kairos.common.v2.Decimal64 (required);
  fee:kairos.common.v2.Decimal64;
  fee_asset_id:string;
  notional:kairos.common.v2.Decimal64;
  source_filled_at_unix_nanos:ulong;
}
