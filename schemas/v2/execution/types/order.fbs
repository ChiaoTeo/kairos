include "../../common/decimal.fbs";
include "../../common/types.fbs";

namespace kairos.execution.v2;

enum OrderType:ubyte {
  UNSPECIFIED = 0,
  MARKET = 1,
  LIMIT = 2,
  STOP_MARKET = 3,
  STOP_LIMIT = 4
}

enum OrderLifecycle:ubyte {
  UNSPECIFIED = 0,
  PENDING = 1,
  SUBMITTING = 2,
  ACCEPTED = 3,
  PARTIALLY_FILLED = 4,
  FILLED = 5,
  CANCEL_REQUESTED = 6,
  CANCELED = 7,
  REJECTED = 8,
  EXPIRED = 9,
  UNKNOWN = 10,
  FAILED = 11
}

enum RouteSelectionKind:ubyte {
  UNSPECIFIED = 0,
  EXPLICIT = 1,
  UNIQUE_CANDIDATE = 2
}

enum DeliveryCertainty:ubyte {
  UNSPECIFIED = 0,
  NOT_SENT = 1,
  INDETERMINATE = 2,
  CONFIRMED = 3,
  REJECTED = 4
}

table SelectedExecutionRoute {
  route_id:string (required);
  selection_kind:RouteSelectionKind = UNSPECIFIED;
  broker_id:string (required);
  destination_market_id:string;
  execution_channel:string (required);
  provider_symbol:string (required);
  selected_at_unix_nanos:ulong;
}

table ExecutionAttempt {
  attempt_id:string (required);
  selected_route:SelectedExecutionRoute (required);
  provider_connection_id:string (required);
  command_started_at_unix_nanos:ulong;
  delivery_certainty:DeliveryCertainty = UNSPECIFIED;
  remote_order_id:string;
}

table OrderState {
  order_id:string (required);
  intent_id:string (required);
  plan_id:string (required);
  leg_id:string (required);
  strategy_id:string (required);
  account_id:string (required);
  segment_key:string (required);
  instrument_id:string (required);
  market_id:string (required);
  execution_route_id:string (required);
  selected_route:SelectedExecutionRoute;
  attempts:[ExecutionAttempt];
  remote_order_id:string;
  side:kairos.common.v2.Side = UNSPECIFIED;
  order_type:OrderType = UNSPECIFIED;
  quantity:kairos.common.v2.Decimal64 (required);
  filled_quantity:kairos.common.v2.Decimal64 (required);
  limit_price:kairos.common.v2.Decimal64;
  average_fill_price:kairos.common.v2.Decimal64;
  lifecycle:OrderLifecycle = UNSPECIFIED;
  created_at_unix_nanos:ulong;
  submitted_at_unix_nanos:ulong = null;
  updated_at_unix_nanos:ulong;
  reason:string;
}

enum CommitmentResourceKind:ubyte {
  UNSPECIFIED = 0,
  ASSET = 1,
  INSTRUMENT = 2,
  MARGIN_NOTIONAL = 3,
  CLOSEABLE_POSITION = 4
}

enum CommitmentBasisKind:ubyte {
  UNSPECIFIED = 0,
  QUOTE_PRICE_CAP = 1,
  BASE_QUANTITY = 2,
  CONTRACT_NOTIONAL = 3,
  SIMULATION_QUANTITY = 4,
  CLOSEABLE_POSITION_QUANTITY = 5
}

enum CommitmentPositionSide:ubyte {
  UNSPECIFIED = 0,
  NET = 1,
  LONG = 2,
  SHORT = 3
}

enum CommitmentLifecycle:ubyte {
  UNSPECIFIED = 0,
  HELD_BEFORE_SEND = 1,
  ACTIVE = 2,
  UNCERTAIN = 3,
  REDUCED = 4,
  RELEASED = 5,
  RECONCILED = 6
}

table OrderCommitmentState {
  order_id:string (required);
  account_id:string (required);
  segment_key:string (required);
  instrument_id:string (required);
  side:kairos.common.v2.Side = UNSPECIFIED;
  resource_kind:CommitmentResourceKind = UNSPECIFIED;
  resource_id:string (required);
  position_side:CommitmentPositionSide = UNSPECIFIED;
  amount:kairos.common.v2.Decimal64 (required);
  remaining_quantity:kairos.common.v2.Decimal64 (required);
  lifecycle:CommitmentLifecycle = UNSPECIFIED;
  basis_kind:CommitmentBasisKind = UNSPECIFIED;
  price_cap:kairos.common.v2.Decimal64;
  contract_size:kairos.common.v2.Decimal64;
  settlement_asset:string;
  reflected_account_watermark:ulong = null;
  updated_at_unix_nanos:ulong;
}

enum RiskReservationSagaLifecycle:ubyte {
  UNSPECIFIED = 0,
  AUTHORIZE_PENDING = 1,
  ACTIVE = 2,
  RESIZE_PENDING = 3,
  RELEASE_PENDING = 4,
  CONSUME_PENDING = 5,
  RELEASED = 6,
  CONSUMED = 7,
  EXPIRED = 8,
  UNCERTAIN = 9,
  FAILED = 10
}

table ExecutionFundingRequirement {
  required_margin:kairos.common.v2.Decimal64 (required);
  available_margin:kairos.common.v2.Decimal64 (required);
  shortfall:kairos.common.v2.Decimal64 (required);
  margin_rule_id:string (required);
  risk_decision_id:string (required);
  risk_policy_version:ulong;
  account_snapshot_watermark:ulong;
  broker:string (required);
  segment:string (required);
  collateral_asset:string (required);
}

table RiskReservationSagaState {
  order_id:string (required);
  reservation_id:string (required);
  idempotency_key:string (required);
  account_id:string (required);
  amount:kairos.common.v2.Decimal64 (required);
  lifecycle:RiskReservationSagaLifecycle = UNSPECIFIED;
  risk_generation:ulong;
  risk_event_sequence:ulong;
  policy_version:ulong;
  expires_at_unix_nanos:ulong;
  updated_at_unix_nanos:ulong;
  funding_requirement:ExecutionFundingRequirement;
}
