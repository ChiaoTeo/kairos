namespace kairos.reference.v2;

enum ReferenceLifecycleStatus:ubyte {
  UNSPECIFIED = 0,
  DRAFT = 1,
  ACTIVE = 2,
  TRADING = 3,
  SUSPENDED = 4,
  INACTIVE = 5,
  RETIRED = 6,
  EXPIRED = 7
}

enum ReferenceRecordKind:ubyte {
  UNSPECIFIED = 0,
  ASSET = 1,
  EXCHANGE = 2,
  INSTRUMENT = 3,
  LISTING = 4,
  MARKET = 5,
  FINANCIAL_PRODUCT = 6,
  EXECUTION_ACCESS = 7,
  MARKET_DATA_ACCESS = 8
}

table ReferenceRecordRef {
  kind:ReferenceRecordKind = UNSPECIFIED;
  record_id:string (required);
}
