include "../../common/metadata.fbs";
include "../types/entity.fbs";
include "../types/asset.fbs";
include "../types/instrument.fbs";
include "../types/listing.fbs";
include "../types/market.fbs";
include "../types/financial_product.fbs";
include "../types/execution_access.fbs";
include "../types/market_data_access.fbs";

namespace kairos.reference.v2;

table ProviderHealthState {
  provider_id:string (required);
  status:string (required);
  message:string;
  updated_at_unix_nanos:ulong;
}

table LifecycleEntry {
  event_id:string (required);
  event_type:string (required);
  event_time_unix_nanos:ulong;
  record_kind:string;
  record_id:string;
}

table ReferenceLatestState {
  entities:[Entity] (required);
  assets:[Asset] (required);
  instruments:[Instrument] (required);
  listings:[Listing] (required);
  markets:[Market] (required);
  financial_products:[FinancialProduct] (required);
  execution_accesses:[ExecutionAccess] (required);
  market_data_accesses:[MarketDataAccess] (required);
  provider_health:[ProviderHealthState] (required);
  option_underlyings:[string] (required);
  lifecycle_events:[LifecycleEntry] (required);
}

table ReferenceLatestView {
  metadata:kairos.common.v2.ViewMetadata (required);
  state:ReferenceLatestState (required);
}

root_type ReferenceLatestView;
file_identifier "RFV2";
