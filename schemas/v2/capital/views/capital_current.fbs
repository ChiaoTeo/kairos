include "../../common/metadata.fbs";
include "../types/state.fbs";

namespace kairos.capital.v2;

table CapitalCurrentState {
  capital_group_id:string (required);
  strategy_id:string (required);
  environment:string (required);
  membership_version:ulong;
  event_sequence:ulong;
  journal_sequence:ulong;
  objectives:[FundingObjective] (required);
  demands:[CapitalDemand] (required);
  policies:[CapitalPolicy] (required);
  facts:[CapitalFacts] (required);
  availability:[CapitalAvailability] (required);
  routes:[CapitalRoute] (required);
  plans:[CapitalPlan] (required);
  reservations:[CapitalReservation] (required);
  operations:[CapitalOperation] (required);
  alerts:[CapitalAlert] (required);
}

table CapitalCurrentView {
  metadata:kairos.common.v2.ViewMetadata (required);
  state:CapitalCurrentState (required);
}

root_type CapitalCurrentView;
file_identifier "CPV2";
