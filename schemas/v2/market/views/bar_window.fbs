include "../../common/metadata.fbs";
include "../types/bar.fbs";

namespace kairos.market.v2;

table WindowBar {
  value:Bar (required);
  source_event_id:string (required);
}

table BarWindowView {
  metadata:kairos.common.v2.ViewMetadata (required);
  shard_id:uint;
  shard_count:uint;
  bars:[WindowBar] (required);
}

root_type BarWindowView;
file_identifier "MBW2";
