include "../../common/decimal.fbs";
include "observation_scope.fbs";

namespace kairos.market.v2;

table Rate {
  rate_id:string (required);
  scope:ObservationScope (required);
  instrument_id:string (required);
  provider:string (required);
  basis:string (required);
  value:kairos.common.v2.Decimal64 (required);
  mark_price:kairos.common.v2.Decimal64;
  source_observed_at_unix_nanos:ulong;
  received_at_unix_nanos:ulong;
}
