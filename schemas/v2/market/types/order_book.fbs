include "../../common/decimal.fbs";

namespace kairos.market.v2;

enum OrderBookSide:ubyte {
  UNSPECIFIED = 0,
  BID = 1,
  ASK = 2
}

enum OrderBookLevelAction:ubyte {
  UNSPECIFIED = 0,
  UPSERT = 1,
  DELETE = 2
}

table OrderBookLevel {
  price:kairos.common.v2.Decimal64 (required);
  quantity:kairos.common.v2.Decimal64 (required);
  order_count:uint;
}

table OrderBookLevelChange {
  side:OrderBookSide = UNSPECIFIED;
  action:OrderBookLevelAction = UNSPECIFIED;
  price:kairos.common.v2.Decimal64 (required);
  quantity:kairos.common.v2.Decimal64;
  order_count:uint;
}

table OrderBookIdentity {
  source_id:string (required);
  market_id:string (required);
  instrument_id:string (required);
}

table OrderBookSnapshotValue {
  identity:OrderBookIdentity (required);
  sequence:ulong;
  source_observed_at_unix_nanos:ulong;
  received_at_unix_nanos:ulong;
  checksum:string;
  depth_policy:string (required);
  bids:[OrderBookLevel] (required);
  asks:[OrderBookLevel] (required);
}

table OrderBookDeltaValue {
  identity:OrderBookIdentity (required);
  first_sequence:ulong;
  last_sequence:ulong;
  source_observed_at_unix_nanos:ulong;
  received_at_unix_nanos:ulong;
  checksum:string;
  changes:[OrderBookLevelChange] (required);
}
