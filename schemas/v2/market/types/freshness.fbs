include "observation_scope.fbs";

namespace kairos.market.v2;

enum FreshnessStatus:ubyte {
  UNSPECIFIED = 0,
  UNKNOWN = 1,
  WARMING_UP = 2,
  CURRENT = 3,
  STALE = 4,
  DEGRADED = 5,
  DISCONNECTED = 6,
  RESYNC_REQUIRED = 7
}

table FreshnessEntry {
  provider:string (required);
  scope:ObservationScope (required);
  data_kind:string (required);
  last_event_time_unix_nanos:ulong;
  last_received_time_unix_nanos:ulong;
  age_nanos:ulong;
  event_sequence:ulong;
  status:FreshnessStatus = UNSPECIFIED;
}
