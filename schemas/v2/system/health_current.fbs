include "../common/metadata.fbs";
include "types/health.fbs";

namespace kairos.system.v2;

table SystemHealthState {
  status:HealthStatus = UNSPECIFIED;
  actors:[ActorHealth] (required);
  connections:[ConnectionHealth] (required);
}

table SystemHealthCurrentView {
  metadata:kairos.common.v2.ViewMetadata (required);
  state:SystemHealthState (required);
}

root_type SystemHealthCurrentView;
file_identifier "SHV2";
