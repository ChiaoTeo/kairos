namespace kairos.system.v2;

enum AlertSeverity:ubyte {
  UNSPECIFIED = 0,
  INFO = 1,
  WARNING = 2,
  ERROR = 3,
  CRITICAL = 4
}

enum AlertStatus:ubyte {
  UNSPECIFIED = 0,
  ACTIVE = 1,
  ACKNOWLEDGED = 2,
  RESOLVED = 3
}

table Alert {
  alert_id:string (required);
  rule_id:string (required);
  severity:AlertSeverity = UNSPECIFIED;
  status:AlertStatus = UNSPECIFIED;
  owner_id:string (required);
  first_seen_unix_nanos:ulong;
  last_seen_unix_nanos:ulong;
  acknowledged_at_unix_nanos:ulong = null;
  resolved_at_unix_nanos:ulong = null;
  correlation_id:string;
  summary:string (required);
  diagnostic_id:string;
}
