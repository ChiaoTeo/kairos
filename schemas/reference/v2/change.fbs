include "../../common/v2/metadata.fbs";

namespace kairos.reference.v2;

enum ReferenceRecordKind:ubyte {
  UNSPECIFIED = 0,
  ASSET = 1,
  EXCHANGE = 2,
  INSTRUMENT = 3,
  LISTING = 4,
  MARKET = 5,
  FINANCIAL_PRODUCT = 6,
  EXECUTION_ACCESS = 7
}

enum ReferenceLifecycleStatus:ubyte {
  UNSPECIFIED = 0,
  DRAFT = 1,
  ACTIVE = 2,
  TRADING = 3,
  SUSPENDED = 4,
  INACTIVE = 5,
  RETIRED = 6,
  EXPIRED = 7
}

table ReferenceRecordRef {
  kind:ReferenceRecordKind = UNSPECIFIED;
  record_id:string (required);
  instrument_id:string;
  listing_id:string;
  market_id:string;
  exchange_id:string;
}

table RecordUpserted {
  record:ReferenceRecordRef (required);
}

table RecordRetired {
  record:ReferenceRecordRef (required);
  previous_status:ReferenceLifecycleStatus = UNSPECIFIED;
}

table StatusChanged {
  record:ReferenceRecordRef (required);
  previous_status:ReferenceLifecycleStatus = UNSPECIFIED;
  current_status:ReferenceLifecycleStatus = UNSPECIFIED;
}

table SymbolChanged {
  record:ReferenceRecordRef (required);
  previous_symbol:string (required);
  current_symbol:string (required);
}

union ReferenceChangePayload {
  RecordUpserted,
  RecordRetired,
  StatusChanged,
  SymbolChanged
}

table ReferenceChange {
  change_id:string (required);
  payload:ReferenceChangePayload (required);
}

/// One committed catalog revision. Consumers query the point-in-time SQLite
/// contract at catalog_revision for full records.
table ReferenceChanged {
  metadata:kairos.common.v2.EventMetadata (required);
  catalog_revision:ulong;
  changes:[ReferenceChange] (required);
}

root_type ReferenceChanged;
file_identifier "RCV2";
