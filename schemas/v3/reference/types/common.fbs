namespace kairos.reference.v3;

enum ReferenceLifecycleStatus:byte { UNKNOWN = 0, DRAFT = 1, ACTIVE = 2, TRADING = 3, INACTIVE = 4, SUSPENDED = 5, DELISTED = 6, EXPIRED = 7 }
enum VenueKind:byte { UNKNOWN = 0, REGULATED_EXCHANGE = 1, REGULATED_MARKET = 2, TRADING_PLATFORM = 3, ATS = 4, PTS = 5, OTC_FACILITY = 6, DEALER = 7, TRADE_REPORTING_FACILITY = 8 }
enum VenueRole:byte { LISTING = 0, EXECUTION = 1, REPORTING = 2 }
enum ListingRole:byte { UNKNOWN = 0, PRIMARY = 1, SECONDARY = 2, CROSS_LISTING = 3, ADMISSION_WITHOUT_PRIMARY_DESIGNATION = 4 }
enum CoverageCompleteness:byte { UNKNOWN = 0, PARTIAL = 1, COMPLETE_FOR_DECLARED_SCOPE = 2 }
enum CoverageState:byte { NOT_CONFIGURED = 0, WAITING = 1, SCANNING = 2, PROMOTING = 3, USABLE = 4, STALE = 5, RETRY_WAITING = 6, PAUSED = 7, UNAVAILABLE = 8 }
enum ReferenceFactKind:byte { VENUE = 0, ASSET = 1, INSTRUMENT = 2, LISTING = 3, MARKET = 4, PROVIDER_CATALOG_MEMBERSHIP = 5, VENUE_IDENTIFIER_MAPPING = 6, TRADING_RULES = 7 }
