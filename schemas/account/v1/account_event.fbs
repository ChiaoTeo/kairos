include "../../common/v1/header.fbs";
include "types.fbs";

namespace kairos.account.v1;

table AccountChange {
  kind:string (required);
  segment_key:string (required);
  balance:Balance;
  position:Position;
  equity:kairos.common.v1.Decimal64;
  status:string;
  stale:bool;
  trading_enabled:bool;
  reason:string;
}

table AccountEvent {
  header:kairos.common.v1.MessageHeader (required);
  account_id:string (required);
  changes:[AccountChange];
  occurred_at_unix_nanos:ulong;
}

root_type AccountEvent;
file_identifier "ACE1";
