include "../../common/v2/decimal.fbs";
include "../../common/v2/types.fbs";

namespace kairos.account.v2;

enum AccountStatus:ubyte {
  UNSPECIFIED = 0,
  ACTIVE = 1,
  RESTRICTED = 2,
  DISABLED = 3,
  CLOSED = 4,
  ERROR = 5
}

enum FreshnessState:ubyte {
  UNSPECIFIED = 0,
  FRESH = 1,
  STALE = 2,
  UNKNOWN = 3
}

enum AccountModel:ubyte {
  UNSPECIFIED = 0,
  CASH = 1,
  MARGIN = 2,
  PORTFOLIO_MARGIN = 3
}

enum MarginMode:ubyte {
  UNSPECIFIED = 0,
  CROSS = 1,
  ISOLATED = 2
}

enum PositionMode:ubyte {
  UNSPECIFIED = 0,
  NET = 1,
  HEDGED = 2
}

enum ObservedOrderStatus:ubyte {
  UNSPECIFIED = 0,
  OPEN = 1,
  PARTIALLY_FILLED = 2,
  PENDING_CANCEL = 3,
  CLOSED = 4,
  UNKNOWN = 5
}

table Balance {
  asset_id:string (required);
  asset_code:string;
  total:kairos.common.v2.Decimal64 (required);
  available:kairos.common.v2.Decimal64;
  locked:kairos.common.v2.Decimal64;
  borrowed:kairos.common.v2.Decimal64;
  interest:kairos.common.v2.Decimal64;
}

table Position {
  instrument_id:string (required);
  market_id:string (required);
  quantity:kairos.common.v2.Decimal64 (required);
  average_price:kairos.common.v2.Decimal64;
  mark_price:kairos.common.v2.Decimal64;
  unrealized_pnl:kairos.common.v2.Decimal64;
  realized_pnl:kairos.common.v2.Decimal64;
  observed_at_unix_nanos:ulong;
}

table AccountValuation {
  valuation_asset_id:string;
  equity:kairos.common.v2.Decimal64;
  initial_equity:kairos.common.v2.Decimal64;
  net_profit:kairos.common.v2.Decimal64;
  observed_at_unix_nanos:ulong;
}

/// Provider-observed account fact. This is not an Execution order lifecycle.
table ObservedOrder {
  observation_id:string (required);
  execution_order_id:string;
  remote_order_id:string;
  instrument_id:string (required);
  market_id:string (required);
  side:kairos.common.v2.Side = UNSPECIFIED;
  quantity:kairos.common.v2.Decimal64 (required);
  filled_quantity:kairos.common.v2.Decimal64 (required);
  status:ObservedOrderStatus = UNSPECIFIED;
  observed_at_unix_nanos:ulong;
}

table AccountSegmentState {
  segment_key:string (required);
  environment:string (required);
  broker:string (required);
  configured_account_model:AccountModel = UNSPECIFIED;
  observed_account_model:AccountModel = UNSPECIFIED;
  status:AccountStatus = UNSPECIFIED;
  freshness:FreshnessState = UNSPECIFIED;
  observed_at_unix_nanos:ulong;
  state_generation:ulong;
  valuation:AccountValuation;
  balances:[Balance] (required);
  collateral:[Balance] (required);
  positions:[Position] (required);
  margin_mode:MarginMode = UNSPECIFIED;
  position_mode:PositionMode = UNSPECIFIED;
}
