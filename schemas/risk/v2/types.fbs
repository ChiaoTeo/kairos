include "../../common/v2/decimal.fbs";
include "../../common/v2/types.fbs";

namespace kairos.risk.v2;

enum Metric:ubyte {
  UNSPECIFIED = 0,
  NOTIONAL = 1,
  MARGIN = 2,
  GROSS_EXPOSURE = 3,
  NET_EXPOSURE = 4,
  TURNOVER = 5,
  ORDER_RATE = 6,
  DAILY_LOSS = 7,
  DRAWDOWN = 8,
  LEVERAGE = 9,
  PRICE_DEVIATION = 10,
  STRESS_LOSS = 11
}

enum EnforcementMode:ubyte {
  UNSPECIFIED = 0,
  REJECT = 1,
  WARN = 2,
  OBSERVE = 3
}

enum ReservationStatus:ubyte {
  UNSPECIFIED = 0,
  RESERVED = 1,
  CONSUMED = 2,
  RELEASED = 3,
  EXPIRED = 4
}

enum DecisionOutcome:ubyte {
  UNSPECIFIED = 0,
  ALLOWED = 1,
  DEGRADED_ALLOWED = 2,
  REJECTED = 3
}

enum ReasonCode:ubyte {
  UNSPECIFIED = 0,
  NO_MATCHING_POLICY = 1,
  LIMIT_EXCEEDED = 2,
  STALE_DEPENDENCY = 3,
  DUPLICATE_REQUEST = 4,
  RESERVATION_NOT_FOUND = 5,
  RESERVATION_NOT_ACTIVE = 6,
  INVALID_REQUEST = 7,
  PERSISTENCE_FAILURE = 8,
  CIRCUIT_OPEN = 9,
  STALE_MARKET = 10,
  INSUFFICIENT_MARGIN = 11,
  LEVERAGE_EXCEEDED = 12,
  LOSS_LIMIT_EXCEEDED = 13
}

enum CircuitStatus:ubyte {
  UNSPECIFIED = 0,
  CLOSED = 1,
  OPEN = 2
}

enum DependencyFreshness:ubyte {
  UNSPECIFIED = 0,
  FRESH = 1,
  STALE = 2,
  UNKNOWN = 3
}

enum CleanupOutcome:ubyte {
  UNSPECIFIED = 0,
  APPLIED = 1,
  ALREADY_TERMINAL = 2,
  NOT_FOUND = 3,
  REJECTED = 4
}

table PolicyScope {
  account_id:string;
  strategy_id:string;
  instrument_id:string;
  exchange_id:string;
}

table RiskPolicy {
  policy_id:string (required);
  version:ulong;
  scope:PolicyScope (required);
  metric:Metric = UNSPECIFIED;
  limit:kairos.common.v2.Decimal64 (required);
  enforcement:EnforcementMode = UNSPECIFIED;
  valid_from_unix_nanos:ulong;
  valid_until_unix_nanos:ulong = null;
  window_nanos:ulong = null;
}

table RiskUsage {
  metric:Metric = UNSPECIFIED;
  amount:kairos.common.v2.Decimal64 (required);
}

table RiskContext {
  evidence:[kairos.common.v2.EvidenceRef] (required);
  current_exposure:kairos.common.v2.Decimal64 (required);
  current_margin:kairos.common.v2.Decimal64 (required);
  available_margin:kairos.common.v2.Decimal64 (required);
  current_pnl:kairos.common.v2.Decimal64 (required);
  current_drawdown:kairos.common.v2.Decimal64 (required);
  market_freshness:DependencyFreshness = UNSPECIFIED;
  leverage_bps:ulong;
  price_deviation_bps:ulong;
  stress_loss:kairos.common.v2.Decimal64 (required);
}

table Allocation {
  policy_id:string (required);
  metric:Metric = UNSPECIFIED;
  amount:kairos.common.v2.Decimal64 (required);
}

table Reservation {
  reservation_id:string (required);
  request_id:string (required);
  account_id:string (required);
  strategy_id:string (required);
  instrument_id:string (required);
  idempotency_key:string (required);
  requested_usages:[RiskUsage] (required);
  allocations:[Allocation] (required);
  status:ReservationStatus = UNSPECIFIED;
  created_at_unix_nanos:ulong;
  updated_at_unix_nanos:ulong;
  expires_at_unix_nanos:ulong;
  policy_version:ulong;
}

table DecisionReason {
  code:ReasonCode = UNSPECIFIED;
  policy_id:string;
  metric:Metric = UNSPECIFIED;
  requested:kairos.common.v2.Decimal64;
  available:kairos.common.v2.Decimal64;
  detail:string;
}

table RiskDecision {
  decision_id:string (required);
  request_id:string (required);
  account_id:string (required);
  strategy_id:string (required);
  instrument_id:string (required);
  outcome:DecisionOutcome = UNSPECIFIED;
  reasons:[DecisionReason] (required);
  allocations:[Allocation] (required);
  reservation:Reservation;
  policy_version:ulong;
  context:RiskContext (required);
  evaluated_at_unix_nanos:ulong;
}

table LimitUsage {
  policy:RiskPolicy (required);
  used:kairos.common.v2.Decimal64 (required);
  reserved:kairos.common.v2.Decimal64 (required);
  available:kairos.common.v2.Decimal64 (required);
}

table CircuitScope {
  account_id:string;
  strategy_id:string;
  exchange_id:string;
}

table CircuitState {
  circuit_id:string (required);
  scope:CircuitScope (required);
  status:CircuitStatus = UNSPECIFIED;
  opened_at_unix_nanos:ulong = null;
  reset_at_unix_nanos:ulong = null;
  reason:string;
}
