include "../../common/v1/decimal.fbs";

namespace kairos.risk.v1;

table RiskContext {
  account_snapshot_watermark:ulong;
  market_freshness_watermark:ulong;
  portfolio_version:ulong;
  current_exposure:kairos.common.v1.Decimal64 (required);
  current_margin:kairos.common.v1.Decimal64 (required);
  available_margin:kairos.common.v1.Decimal64 (required);
  current_pnl:long;
  current_drawdown:kairos.common.v1.Decimal64 (required);
  market_is_fresh:bool = true;
  leverage_bps:ulong;
  price_deviation_bps:ulong;
  stress_loss:kairos.common.v1.Decimal64 (required);
}

table CircuitState {
  account_id:string;
  strategy_id:string;
  exchange_id:string;
  state:string (required);
  opened_at_unix_nanos:ulong;
  reset_at_unix_nanos:ulong;
  reason:string (required);
}

table Allocation {
  budget_id:string (required);
  metric:string (required);
  amount:kairos.common.v1.Decimal64 (required);
}

table BudgetRef {
  scope:string (required);
  subject:string (required);
}

table Usage {
  metric:string (required);
  amount:kairos.common.v1.Decimal64 (required);
  budgets:[BudgetRef];
}

table Budget {
  budget_id:string (required);
  owner_id:string (required);
  account_id:string;
  instrument_id:string;
  metric:string (required);
  limit:kairos.common.v1.Decimal64 (required);
  used:kairos.common.v1.Decimal64 (required);
  reserved:kairos.common.v1.Decimal64 (required);
  available:kairos.common.v1.Decimal64 (required);
  status:string (required);
}

table Reservation {
  reservation_id:string (required);
  owner_id:string (required);
  idempotency_key:string;
  intent_id:string;
  account_id:string;
  instrument_id:string;
  metric:string (required);
  amount:kairos.common.v1.Decimal64 (required);
  allocations:[Allocation];
  status:string (required);
  created_at_unix_nanos:ulong;
  updated_at_unix_nanos:ulong;
  expires_at_unix_nanos:ulong;
  policy_version:ulong;
}
