include "../../common/v1/header.fbs";
include "types.fbs";

namespace kairos.risk.v1;

table AuthorizeRiskRequest {
  header:kairos.common.v1.MessageHeader (required);
  request_id:string (required);
  idempotency_key:string (required);
  reservation_id:string (required);
  account_id:string (required);
  strategy_id:string;
  instrument_id:string (required);
  exchange_id:string;
  metric:string (required);
  amount:kairos.common.v1.Decimal64 (required);
  at_unix_nanos:ulong;
  reservation_ttl_nanos:ulong;
  dependency_generation:ulong;
  dependency_event_sequence:ulong;
  context:RiskContext;
}

root_type AuthorizeRiskRequest;
file_identifier "RAR3";
