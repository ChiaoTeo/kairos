include "../../../common/v1/snapshot_header.fbs";
include "../../../reference/v1/entities.fbs";

namespace kairos.reference.v1;

// A collection snapshot contains one current Reference collection. The
// unused collection fields are omitted by the publisher; the view key in the
// common header identifies which field is authoritative.
table ReferenceCollections {
  entities:[kairos.reference.v1.Entity];
  assets:[kairos.reference.v1.Asset];
  instruments:[kairos.reference.v1.Instrument];
  listings:[kairos.reference.v1.Listing];
  markets:[kairos.reference.v1.Market];
  financial_products:[kairos.reference.v1.FinancialProduct];
  execution_accesses:[kairos.reference.v1.ExecutionAccess];
}

table ReferenceCollectionsSnapshot {
  header:kairos.common.v1.SnapshotHeader (required);
  payload:ReferenceCollections (required);
}

root_type ReferenceCollectionsSnapshot;
file_identifier "PRS1";
