include "../../../common/v1/snapshot_header.fbs";
include "../../../reference/v1/entities.fbs";

namespace kairos.reference.v1;

table Markets {
  total_count:ulong;
  active_count:ulong;
  markets:[kairos.reference.v1.Market];
}

table MarketsSnapshot {
  header:kairos.common.v1.SnapshotHeader (required);
  payload:Markets (required);
}

root_type MarketsSnapshot;
file_identifier "PRD1";
