include "../../../common/v1/snapshot_header.fbs";
include "../../../market/v1/quote.fbs";
include "../../../market/v1/trade.fbs";
include "../../../market/v1/data.fbs";

namespace kairos.market.v1;

table MarketFreshness {
  source_id:string (required);
  market_id:string (required);
  data_kind:string (required);
  last_event_time_unix_nanos:ulong;
  last_received_time_unix_nanos:ulong;
  event_sequence:ulong;
  status:string (required);
}

table MarketData {
  quote_count:ulong;
  trade_count:ulong;
  bar_count:ulong;
  rate_count:ulong;
  greeks_count:ulong;
  ticker_24h_count:ulong;
  mark_price_count:ulong;
  index_price_count:ulong;
  funding_rate_count:ulong;
  open_interest_count:ulong;
  quotes:[kairos.market.v1.Quote];
  trades:[kairos.market.v1.Trade];
  bars:[kairos.market.v1.Bar];
  rates:[kairos.market.v1.Rate];
  greeks:[kairos.market.v1.Greeks];
  ticker_24h:[kairos.market.v1.Ticker24h];
  mark_prices:[kairos.market.v1.MarkPrice];
  index_prices:[kairos.market.v1.IndexPrice];
  funding_rates:[kairos.market.v1.FundingRate];
  open_interests:[kairos.market.v1.OpenInterest];
  freshness:[kairos.market.v1.MarketFreshness];
  instrument_statuses:[kairos.market.v1.InstrumentStatus];
}

table MarketDataSnapshot {
  header:kairos.common.v1.SnapshotHeader (required);
  payload:MarketData (required);
}

root_type MarketDataSnapshot;
file_identifier "PMC1";
