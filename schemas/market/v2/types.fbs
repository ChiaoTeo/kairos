include "../../common/v2/decimal.fbs";
include "../../common/v2/types.fbs";

namespace kairos.market.v2;

enum BarKind:ubyte {
  UNSPECIFIED = 0,
  TRADES = 1,
  QUOTES = 2,
  MIDPOINT = 3
}

table QuoteObservation {
  quote_id:string;
  market_id:string (required);
  instrument_id:string (required);
  source_id:string (required);
  bid_price:kairos.common.v2.Decimal64;
  bid_quantity:kairos.common.v2.Decimal64;
  ask_price:kairos.common.v2.Decimal64;
  ask_quantity:kairos.common.v2.Decimal64;
  source_observed_at_unix_nanos:ulong;
  received_at_unix_nanos:ulong;
}

table TradeObservation {
  trade_id:string;
  market_id:string (required);
  instrument_id:string (required);
  source_id:string (required);
  price:kairos.common.v2.Decimal64 (required);
  quantity:kairos.common.v2.Decimal64 (required);
  aggressor_side:kairos.common.v2.Side = UNSPECIFIED;
  source_observed_at_unix_nanos:ulong;
  received_at_unix_nanos:ulong;
}

table CompletedBar {
  market_id:string (required);
  instrument_id:string (required);
  source_id:string (required);
  bar_spec_id:string (required);
  kind:BarKind = UNSPECIFIED;
  window_start_unix_nanos:ulong;
  window_end_unix_nanos:ulong;
  open:kairos.common.v2.Decimal64 (required);
  high:kairos.common.v2.Decimal64 (required);
  low:kairos.common.v2.Decimal64 (required);
  close:kairos.common.v2.Decimal64 (required);
  volume:kairos.common.v2.Decimal64;
  source_observed_at_unix_nanos:ulong;
  received_at_unix_nanos:ulong;
}

table GreeksObservation {
  market_id:string (required);
  instrument_id:string (required);
  source_id:string (required);
  expiry_unix_nanos:ulong = null;
  strike:kairos.common.v2.Decimal64;
  delta:kairos.common.v2.Decimal64;
  gamma:kairos.common.v2.Decimal64;
  vega:kairos.common.v2.Decimal64;
  theta:kairos.common.v2.Decimal64;
  implied_volatility:kairos.common.v2.Decimal64;
  source_observed_at_unix_nanos:ulong;
  received_at_unix_nanos:ulong;
  derivation_id:string;
}

table CurrentQuote {
  value:QuoteObservation (required);
  source_event_id:string (required);
}

table CurrentBar {
  value:CompletedBar (required);
  source_event_id:string (required);
}

table CurrentGreeks {
  value:GreeksObservation (required);
  source_event_id:string (required);
}
