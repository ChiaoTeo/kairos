include "../../common/v1/decimal.fbs";
include "../../common/v1/header.fbs";

namespace kairos.market.v1;

table Bar {
  market_id:string (required);
  instrument_id:string (required);
  timeframe:string (required);
  open:kairos.common.v1.Decimal64 (required);
  high:kairos.common.v1.Decimal64 (required);
  low:kairos.common.v1.Decimal64 (required);
  close:kairos.common.v1.Decimal64 (required);
  volume:kairos.common.v1.Decimal64;
  event_time_unix_nanos:ulong;
  source_id:string;
  derivation:string;
  bar_kind:string;
}


table Rate {
  rate_id:string (required);
  market_id:string;
  instrument_id:string;
  basis:string;
  value:kairos.common.v1.Decimal64 (required);
  mark_price:kairos.common.v1.Decimal64;
  event_time_unix_nanos:ulong;
  source_id:string;
}

table Ticker24h {
  market_id:string (required);
  instrument_id:string (required);
  last_price:kairos.common.v1.Decimal64;
  bid_price:kairos.common.v1.Decimal64;
  bid_quantity:kairos.common.v1.Decimal64;
  ask_price:kairos.common.v1.Decimal64;
  ask_quantity:kairos.common.v1.Decimal64;
  open_price:kairos.common.v1.Decimal64;
  high_price:kairos.common.v1.Decimal64;
  low_price:kairos.common.v1.Decimal64;
  volume_base:kairos.common.v1.Decimal64;
  volume_quote:kairos.common.v1.Decimal64;
  price_change_abs:kairos.common.v1.Decimal64;
  price_change_pct:kairos.common.v1.Decimal64;
  vwap:kairos.common.v1.Decimal64;
  mark_price:kairos.common.v1.Decimal64;
  event_time_unix_nanos:ulong;
  source_id:string;
}

table MarkPrice {
  market_id:string (required);
  instrument_id:string (required);
  mark_price:kairos.common.v1.Decimal64 (required);
  index_price:kairos.common.v1.Decimal64;
  estimated_settlement_price:kairos.common.v1.Decimal64;
  funding_rate:kairos.common.v1.Decimal64;
  next_funding_time_unix_nanos:ulong;
  event_time_unix_nanos:ulong;
  source_id:string;
}

table IndexPrice {
  market_id:string (required);
  instrument_id:string (required);
  spot_index_price:kairos.common.v1.Decimal64;
  contract_index_price:kairos.common.v1.Decimal64;
  index_price:kairos.common.v1.Decimal64;
  funding_rate:kairos.common.v1.Decimal64;
  event_time_unix_nanos:ulong;
  source_id:string;
}

table FundingRate {
  market_id:string (required);
  instrument_id:string (required);
  funding_rate:kairos.common.v1.Decimal64 (required);
  funding_period_seconds:ulong;
  next_funding_time_unix_nanos:ulong;
  event_time_unix_nanos:ulong;
  source_id:string;
}

table OpenInterest {
  market_id:string (required);
  instrument_id:string (required);
  contracts:kairos.common.v1.Decimal64 (required);
  quote_value:kairos.common.v1.Decimal64;
  change_24h:kairos.common.v1.Decimal64;
  change_pct_24h:kairos.common.v1.Decimal64;
  event_time_unix_nanos:ulong;
  source_id:string;
}

table InstrumentStatus {
  market_id:string (required);
  instrument_id:string (required);
  status:string (required);
  reason:string;
  effective_at_unix_nanos:ulong;
  event_time_unix_nanos:ulong;
  source_id:string;
}

table Greeks {
  market_id:string;
  instrument_id:string (required);
  expiry_unix_nanos:ulong;
  strike:kairos.common.v1.Decimal64;
  delta:kairos.common.v1.Decimal64;
  gamma:kairos.common.v1.Decimal64;
  vega:kairos.common.v1.Decimal64;
  theta:kairos.common.v1.Decimal64;
  implied_volatility:kairos.common.v1.Decimal64;
  event_time_unix_nanos:ulong;
  source_id:string;
  derivation:string;
}


table OrderBookLevel {
  price:kairos.common.v1.Decimal64 (required);
  quantity:kairos.common.v1.Decimal64 (required);
  order_count:uint;
}

table Subscription {
  subscription_id:string (required);
  owner_id:string (required);
  market_id:string (required);
  selectors:[string];
  provider_id:string;
  stream:string;
  status:string (required);
  error:string;
  updated_at_unix_nanos:ulong;
}
