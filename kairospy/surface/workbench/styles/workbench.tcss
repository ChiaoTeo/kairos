Screen {
    layout: vertical;
    background: $surface-darken-2;
}

#workspace-header {
    height: 2;
    margin: 1 3 0 3;
    border-bottom: solid $primary-muted;
}

#viewport-warning {
    display: none;
    height: 1;
    padding: 0 1;
    color: $warning;
    text-style: bold;
}

#workspace-title {
    width: 1fr;
    height: 1;
}

#workspace-status {
    width: auto;
    height: 1;
}

#status-indicator {
    width: 2;
    height: 1;
}

#command-status {
    width: auto;
    height: 1;
    content-align: right middle;
}

#command-output {
    height: 1fr;
    min-height: 5;
    margin: 1 2 0 2;
    padding: 0 1;
    border: none;
    background: $surface-darken-2;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#activity-empty {
    display: none;
}

#operation-dock {
    height: auto;
    margin: 0 2;
    border: none;
    border-top: solid $surface-lighten-2;
    background: $surface-darken-2;
}

#operation-dock:focus-within {
    border-top: solid $surface-lighten-2;
}

#interaction-region {
    height: auto;
    min-height: 1;
    max-height: 40vh;
    margin: 0;
    border: none;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

#interaction-region:focus-within {
    border: none;
    background: $primary 4%;
}

#interaction-content {
    display: none;
    height: auto;
    padding: 0;
}

#guided-actions {
    height: auto;
    max-height: 9;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $surface-darken-2;
}

#guided-actions:focus {
    background: $primary 4%;
}

#guided-actions > .option-list--option {
    padding: 0 1;
}

#command-bar {
    height: 4;
    margin: 0;
    border: none;
    border-top: solid $surface-lighten-2;
    background: $surface-darken-2;
}

#command-bar:focus-within {
    border: none;
    border-top: solid $surface-lighten-2;
}

#command-context {
    width: auto;
    height: 1fr;
    padding: 0 1;
    content-align: center middle;
    color: $primary;
    text-style: bold;
    background: $surface-darken-2;
}

#command-input {
    width: 1fr;
    height: 1fr;
    margin: 0;
    padding: 1 1;
    border: none;
    background: $surface-darken-2;
}

#command-input:focus {
    color: $text;
    background: $primary 6%;
}

#command-hints {
    height: 1;
    padding: 0 3;
    color: $text-muted;
}

Screen.viewport-narrow #workspace-header {
    margin: 0 1;
}

Screen.viewport-narrow #workspace-status {
    display: none;
}

Screen.viewport-narrow #command-output {
    min-height: 3;
    margin: 0 1;
    padding: 0;
}

Screen.viewport-narrow #operation-dock {
    margin-left: 1;
    margin-right: 1;
}

Screen.viewport-narrow #command-hints {
    height: 1;
    padding: 0 1;
}

Screen.viewport-short #workspace-header {
    margin-top: 0;
}

Screen.viewport-short #command-output {
    min-height: 3;
    margin-top: 0;
}

Screen.viewport-short #interaction-region {
    max-height: 45vh;
}

Screen.viewport-short #command-hints {
    height: 1;
}

Screen.viewport-too-small #workspace-header,
Screen.viewport-too-small #command-output,
Screen.viewport-too-small #interaction-region {
    display: none;
}

Screen.viewport-too-small #command-bar {
    height: 1;
    border-top: none;
}

Screen.viewport-too-small #viewport-warning {
    display: block;
}

Footer {
    dock: bottom;
    background: $surface-darken-1;
}

#page-title {
    height: 3;
    padding: 1 2 0 2;
    text-style: bold;
    color: $text;
}

#workspace-summary {
    height: 2;
    padding: 0 2;
    color: $text-muted;
}

#home-kicker {
    height: 2;
    padding: 1 2 0 2;
    color: $accent;
    text-style: bold;
}

ActionList {
    height: auto;
    max-height: 1fr;
    margin: 0 1 1 1;
    padding: 1;
    border: round $primary-muted;
    background: $surface;
}

ActionList:focus {
    border: round $primary;
}

ActionList > .option-list--option {
    padding: 0 1;
}

ActionList > .option-list--option-highlighted {
    background: $primary 22%;
    color: $text;
    text-style: none;
}

.action-cards > .option-list--option {
    padding: 0 2;
}

.status-line {
    height: auto;
    min-height: 2;
    margin: 0 1;
    padding: 0 1;
    color: $text-muted;
    border-left: thick $accent;
}

RichLog {
    height: 1fr;
    min-height: 5;
    margin: 0 1 1 1;
    padding: 1 2;
    border: round $surface-lighten-2;
    background: $surface;
}

ModalScreen {
    align: center middle;
    background: $background 65%;
}

.dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.dialog-title {
    height: 2;
    text-style: bold;
}

.dialog-message {
    height: auto;
    margin-bottom: 1;
}

.dialog-actions {
    height: 3;
    align-horizontal: right;
}

.dialog-actions Button {
    margin-left: 1;
}

#dialog-options {
    height: auto;
    max-height: 20;
}

#resource-form {
    height: 1fr;
    padding: 0 2 1 2;
}

#launch-form {
    height: 1fr;
    padding: 0 2 1 2;
}

#launch-form Label {
    margin-top: 1;
}

#launch-form-help, #launch-form-error {
    color: $text-muted;
}

#connected-fields, #execution-fields, #backtest-fields, #live-fields {
    height: auto;
}

#execution-order-form {
    height: 1fr;
    padding: 0 2 1 2;
}

#execution-order-form Label {
    margin-top: 1;
}

#execution-order-error {
    color: $text-muted;
}

#standalone-order-form {
    height: 1fr;
    padding: 0 2 1 2;
}

#standalone-order-form Label {
    margin-top: 1;
}

#standalone-order-error {
    color: $text-muted;
}

#resource-form Label {
    margin-top: 1;
}

#resource-form-help, #resource-form-error, #observe-status {
    color: $text-muted;
}

.form-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

.form-actions Button {
    margin-left: 1;
}

#observe-summary, #observe-status {
    height: 2;
    padding: 0 2;
}

#attach-result {
    height: 2fr;
}

#attach-python {
    height: 1fr;
    min-height: 6;
    margin: 0 1;
}

#attach-python-run {
    dock: bottom;
    margin: 0 2 1 2;
}

#observe-body {
    height: 1fr;
    padding: 0 1;
}

#observe-components-panel {
    width: 2fr;
    border: round $surface-lighten-2;
}

#observe-side {
    width: 1fr;
    margin-left: 1;
    border: round $surface-lighten-2;
}

.panel-title {
    height: 1;
    padding: 0 1;
    color: $primary;
    text-style: bold;
}
